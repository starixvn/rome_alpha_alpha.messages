@model MessagesViewModel
@{
    Layout = null;
}
@helper RenderMessages(string messageTypeName)
{
    <div role="tabpanel" class="tab-pane active" id="@messageTypeName">
        @Html.Partial("Messages", Model)
    </div>
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title>Home</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="shortcut icon" type="image/x-icon" href="~/favico.ico" />
    @StaticResources.AssetStyles.RenderCommon("/bundles/common/common")
    @StaticResources.AssetStyles.Render($"/bundles/site-main/message/message-{Model.UserLevelName}")
    @StaticResources.RenderStyles("~/assets/bundles/default-message")
</head>
<body>
    <ul class="nav nav-tabs" role="tablist">
        <li role="presentation" class="@(Model.MessageType == MessageType.Public ? "active" : string.Empty) ">
            @Html.ActionLink(Resources.normalAnnouncement, "Messages", new { messageType = MessageType.Public })
        </li>
        <li role="presentation" class="@(Model.MessageType == MessageType.Special ? "active" : string.Empty) ">
            @Html.ActionLink(Resources.specialAnnouncement, "Messages", new { messageType = MessageType.Special })
        </li>
        <li role="presentation" class="@(Model.MessageType == MessageType.Private ? "active" : string.Empty) ">
            @Html.ActionLink(Resources.personalMessage, "Messages", new { messageType = MessageType.Private })
        </li>
    </ul>
    <div class="tab-content">
        @RenderMessages(Model.MessageTypeName)
    </div>
    @Html.Partial("HiddenFields", Model)
    @StaticResources.AssetScripts.RenderCommon("/bundles/common/common")
    @StaticResources.AssetScripts.Render("/bundles/site-main/message/message-default")
    @StaticResources.RenderScripts("~/assets/bundles/default-message")
    @GoogleAnalyticHepler.Render()
</body>
</html>
