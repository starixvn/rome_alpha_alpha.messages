@model AlphaAnnouncement

@{
    Layout = null;
}
<html>
<head>    
    @StaticResources.AssetStyles.RenderCommon("/bundles/common/common")
    @StaticResources.RenderStyles("~/assets/bundles/popup")
</head>
<body>
    @if (Model != null)
    {
        <div id="popupContent">
            @Html.Raw(Model.Content)
        </div>
    }
    @StaticResources.AssetScripts.RenderCommon("/bundles/common/common")
    @StaticResources.RenderScripts("~/assets/bundles/popup")
</body>
</html>
