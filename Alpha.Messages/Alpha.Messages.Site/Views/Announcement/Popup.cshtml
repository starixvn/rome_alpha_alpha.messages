@model AlphaAnnouncement
@{
    Layout = null;
    var darkModeName = ViewData["DarkModeName"];
}
<html>
<head>    
    @StaticResources.AssetStyles.RenderCommon($"/bundles/common/common{darkModeName}")
    @StaticResources.RenderStyles($"~/assets/bundles/popup{darkModeName}")
</head>
<body>
    @if (Model != null)
    {
        <div id="popupContent" data-messageId="@Model.Id">
            @Html.Raw(Model.Content)
        </div>
    }
    @StaticResources.AssetScripts.RenderCommon("/bundles/common/common")
    @StaticResources.RenderScripts("~/assets/bundles/popup")
</body>
</html>
