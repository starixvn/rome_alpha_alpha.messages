@model HotAnnouncementViewModel
@{
    Layout = null;
    var index = 0;
}
@if (Model.Announcements.Any())
{
    foreach (var announcement in Model.Announcements)
    {
        index++;
        <div id="announcement_@announcement.Id" class="js-announcement">
            @if (!string.IsNullOrEmpty(announcement.Source))
            {
                @Html.Partial("PopupAnnouncementWithSource", announcement)
            }
            else if(!string.IsNullOrEmpty(announcement.Content))
            {
                @Html.Partial("PopupAnnouncementWithText", announcement)
            }
            @Html.Hidden("AnnouncementId", announcement.Id)
        </div>
    }
    
    @Html.Hidden("announcement-cookies-id", Model.CookiesId)
    @Html.Hidden("no-info", Resources.NoInformationIsAvailable);
}