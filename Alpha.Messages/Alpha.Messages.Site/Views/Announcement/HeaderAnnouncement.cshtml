@model IEnumerable<HotAnnouncement>
@{
    Layout = null;
}


@if (Model.Any())
{
    <div class="modal fade message-modal" id="userMessageModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel">
        <div class="modal-dialog modal-sm" role="document">
            <div class="modal-content">
                <div class="modal-body" id="userMessageModalBody">
                    <button type="button" class="icon icon-close close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true"></span></button>
                    <div id="msg-content">
                        @{
                            var isFirstMessage = true;

                            foreach (var announcement in Model)
                            {
                                <p class="@(isFirstMessage ? "current-hot-message" : "not-shown-message")">@Html.Raw(announcement.Content)</p>

                                if (isFirstMessage)
                                {
                                    isFirstMessage = false;
                                }
                            }
                        }
                    </div>
                    <a class="link hide showmore-container">@Resources.more</a>
                    <a class="link hide showless-container">@Resources.less</a>
                </div>
            </div>
        </div>
    </div>
}
else
{
    @Html.Hidden("no-info", Resources.NoInformationIsAvailable);
}