@model NoticeViewModel
@{ 
    Layout = null;
}
<div class="notice-container">
    <div class="panel-title"><span class="icon-announcements"></span>@Resources.announcement</div>
    @Html.Action("NoticeMessages", new { lastPostDate = DateTime.MaxValue, totalMessage = Model.TotalMessage })

    <div class="more-info" totalMsg="@(Model.TotalMessage + 10)">
        @Resources.more
        <span class="icon-arrow-down icon-more"></span>
    </div>
</div>