<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
        <section name="Fanex.Logging" type="Fanex.Logging.Configuration.LoggingSettings, Fanex.Logging" />
    <section name="Fanex.Caching" type="Fanex.Caching.Configuration.CacheSettings, Fanex.Caching" /></configSections>
  <Fanex.Logging msmqPath="FormatName:DIRECT=tcp:[IP]\private$\entlib" defaultCategory="$CategoryValue" />
<Fanex.Caching cacheType="Fanex.Caching.Memory.MemoryCache, Fanex.Caching">
        <connectionSettings>
            <add name="CompactOnMemoryPressure" value="true" />
            <add name="ExpirationScanFrequency" value="1" />
        </connectionSettings>
    </Fanex.Caching></configuration>